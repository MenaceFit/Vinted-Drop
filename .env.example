# --- Photos GRATUITES sur ton PC (carte graphique NVIDIA 12 Go+) : voir docs/PHOTOS_GRATUITES.md ---
# Adresse de ComfyUI. Même machine : http://127.0.0.1:8188
COMFYUI_URL=
COMFY_UNET=qwen_image_edit_2509_fp8_e4m3fn.safetensors
COMFY_CLIP=qwen_2.5_vl_7b_fp8_scaled.safetensors
COMFY_VAE=qwen_image_vae.safetensors
# LoRA "Lightning" : 4 étapes au lieu de 20 (5x plus rapide). Vide = sans LoRA
COMFY_LORA=Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors
COMFY_STEPS=4

# --- Photos payantes (secours si le PC est éteint ou si une photo est ratée) ---
# Google Gemini (Nano Banana) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# 1K (0,034 $/image) | 2K (0,050 $) | 4K
GEMINI_IMAGE_SIZE=1K
GEMINI_TEXT_MODEL=gemini-3-flash-preview

# OpenAI : https://platform.openai.com/api-keys  (sert aussi aux fiches, réponses et à l'assistant)
OPENAI_API_KEY=sk-...
# gpt-image-1 a été arrêté le 23/10/2026
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# low | medium | high
OPENAI_IMAGE_QUALITY=medium
OPENAI_TEXT_MODEL=gpt-5.6-terra

# Fournisseur préféré en mode "auto" : local (gratuit), gemini ou openai
# (vide = local si COMFYUI_URL est rempli, sinon gemini)
PHOTO_PROVIDER=
# Note de fidélité minimale (0-10) : en dessous la photo est refaite une fois
PHOTO_QA_MIN=7
# Coût estimé par image (€), pour le suivi des dépenses
COST_IMAGE_GEMINI=0.03
COST_IMAGE_OPENAI=0.05

# --- Telegram ---
# Crée un bot avec @BotFather et colle le token ici
TELEGRAM_BOT_TOKEN=
# Ton chat id (envoie /start au bot en privé, il te l'affiche). Plusieurs ids séparés par des virgules.
TELEGRAM_ALLOWED_CHAT_IDS=
# Canal où le bot poste les ventes, validations et récaps (ajoute le bot en ADMIN du canal).
# Colle l'id (-100...) ou directement le lien https://web.telegram.org/a/#-100...
TELEGRAM_CHANNEL_ID=
# Heure du récap quotidien (HH:MM, heure de Paris)
DAILY_REPORT_TIME=21:00

# --- Dashboard ---
DASHBOARD_USER=admin
# Laisse vide pour désactiver le mot de passe (déconseillé sur un VPS)
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8000
# URL publique du dashboard (pour les liens envoyés par Telegram)
DASHBOARD_URL=http://localhost:8000

# --- Prix ---
# Multiplicateur visé sur le prix d'achat (2.5 = x2.5)
TARGET_MULTIPLIER=2.5
# Bénéfice minimum par article en €
MIN_PROFIT=8
# Marge laissée pour la négociation (0.15 = prix affiché 15% au-dessus du prix visé)
NEGOTIATION_BUFFER=0.15
# Frais d'emballage par colis en €
PACKAGING_COST=0.5
