# --- Photos GRATUITES sur ton PC : tout se règle dans le dashboard, page « Photos gratuites » ---
# Ces lignes sont facultatives (valeurs par défaut). Voir docs/PHOTOS_GRATUITES.md
# Adresse de ComfyUI (vide = bouton « Détecter » du dashboard). Même machine : http://127.0.0.1:8188
COMFYUI_URL=
# Dossier de ComfyUI sur ce PC (téléchargement des modèles, démarrage)
COMFY_DIR=
# Profil : standard (12 Go de VRAM+), leger (8-11 Go, GGUF) ou 2509 (ancien). Vide = standard
COMFY_PRESET=

# --- Photos payantes (secours si le PC est éteint ou si une photo est ratée) ---
# Google Gemini (Nano Banana) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# 1K (0,034 $/image) | 2K (0,050 $) | 4K
GEMINI_IMAGE_SIZE=1K
GEMINI_TEXT_MODEL=gemini-3-flash-preview

# OpenAI : https://platform.openai.com/api-keys  (sert aussi aux fiches, réponses et à l'assistant)
OPENAI_API_KEY=sk-...
# gpt-image-1 a été arrêté le 23/10/2026
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# low | medium | high
OPENAI_IMAGE_QUALITY=medium
OPENAI_TEXT_MODEL=gpt-5.6-terra
# Modèles essayés si le premier n'existe plus (séparés par des virgules)
OPENAI_TEXT_FALLBACKS=gpt-5.6-terra,gpt-4o-mini

# Fournisseur préféré en mode "auto" : local (gratuit), gemini ou openai
# (vide = local si COMFYUI_URL est rempli, sinon gemini)
PHOTO_PROVIDER=
# Note de fidélité minimale (0-10) : en dessous la photo est refaite une fois
PHOTO_QA_MIN=7
# Coût estimé par image (€), pour le suivi des dépenses
COST_IMAGE_GEMINI=0.03
COST_IMAGE_OPENAI=0.05

# --- Telegram ---
# Crée un bot avec @BotFather et colle le token ici
TELEGRAM_BOT_TOKEN=
# Ton chat id (envoie /start au bot en privé, il te l'affiche). Plusieurs ids séparés par des virgules.
TELEGRAM_ALLOWED_CHAT_IDS=
# Canal où le bot poste les ventes, validations et récaps (ajoute le bot en ADMIN du canal).
# Colle l'id (-100...) ou directement le lien https://web.telegram.org/a/#-100...
TELEGRAM_CHANNEL_ID=
# (2.0) L'heure du rapport quotidien se règle dans Dashboard → Pilote auto → « Rapport financier ».

# --- Dashboard ---
DASHBOARD_USER=admin
# Laisse vide pour désactiver le mot de passe (déconseillé sur un VPS)
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8000
# 127.0.0.1 = seulement ce PC (le plus sûr). Sur un VPS : 0.0.0.0 ET un DASHBOARD_PASSWORD
DASHBOARD_HOST=127.0.0.1
# Ouvre le navigateur automatiquement au lancement (1 = oui, 0 = non)
DASHBOARD_OPEN_BROWSER=1
# URL publique du dashboard (pour les liens envoyés par Telegram)
DASHBOARD_URL=http://localhost:8000

# --- Prix (valeurs par défaut ; modifiables ensuite dans Dashboard → Paramètres) ---
# Multiplicateur visé sur le prix d'achat (2.5 = x2.5)
TARGET_MULTIPLIER=2.5
# Bénéfice minimum par vente en € (2.2 : 20 € par défaut)
MIN_PROFIT=20
# Marge laissée pour la négociation (0.15 = prix affiché 15 % au-dessus du prix minimum)
NEGOTIATION_BUFFER=0.15
# Coût fixe payé à chaque vente en € (emballage, étiquette, dépôt…) — remplace PACKAGING_COST
COST_PER_SALE=3
# Frais de plateforme payés par le vendeur, en % du prix (compte particulier Vinted : 0)
PLATFORM_FEE_PCT=0
# Depop (vendeur en France) : 10 % Depop + PayPal ≈ 2,9 % + 0,35 € — ajuste selon ton compte PayPal
DEPOP_FEE_PCT=12.9
DEPOP_FIXED_FEE=0.35

# --- Sécurité et fiabilité (2.0) ---
# Clé de chiffrement des tokens Vinted. Vide = générée dans data/secret.key (à sauvegarder avec la base !)
SECRET_KEY=
# Nombre de sauvegardes gardées dans data/backups/
BACKUP_KEEP=14
# Tâches de fond simultanées (photos, fiches, synchro)
TASK_WORKERS=3
